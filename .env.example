# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: The API key for Gemini API calls (server-side only).
# AI Studio provides this automatically at runtime when configured in Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FFGLORY_API_KEY: Personal FFGlory Panel Reseller API key (server-side only, never exposed to browser).
FFGLORY_API_KEY=

# FFGLORY_MASTER_KEY: FFGlory Panel x-api-key header secret (server-side only).
FFGLORY_MASTER_KEY=

# ADMIN_PASSCODE: Optional server-side owner passcode for preview/iframe sign-in (overrides first-run claimed hash).
ADMIN_PASSCODE=
